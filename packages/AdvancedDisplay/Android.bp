android_app {
    name: "AdvancedDisplay",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    platform_apis: true,

    static_libs: [
        "com.android.internal",
        "org.lineageos.settings.resources",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
